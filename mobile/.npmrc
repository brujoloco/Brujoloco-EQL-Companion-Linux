# The repo's own rule, restated for this project because npm reads the .npmrc beside the
# package.json it is installing and never the one a directory above.
#
# ignore-scripts: no dependency's install hook runs. The desktop tree has one package that needs
# its hook run by hand (electron); nothing in an Expo managed project does — the native build
# happens on EAS from the config, not from a postinstall.
ignore-scripts=true
audit-level=moderate
