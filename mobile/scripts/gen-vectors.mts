// gen-vectors.mts — the conformance vectors, generated by the DESKTOP's own cipher.
//
// Run from the repo root:
//
//   npx tsx mobile/scripts/gen-vectors.mts
//
// It imports `src/main/phone/crypto.ts` — the real `node:crypto` AES-256-GCM module the desktop
// app seals every frame with — and writes out one row per case that `tests/phoneCrypto.test.mts`
// asserts, so `mobile/src/phone/crypto.test.ts` can assert the SAME cases against the phone's pure
// JavaScript implementation. Two independent ciphers, one set of bytes, one verdict.
//
// THE JSON IS COMMITTED. The mobile test suite must run on a machine with no Electron, no desktop
// node_modules and no access to this repo's main process — a CI job that does `npm ci` in
// `mobile/` and nothing else. A generator that had to run first would make that impossible.

import { writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { encryptFrame, mintPairing } from '../../src/main/phone/crypto'
import { PHONE_CHANNELS, type PhoneChannel } from '../../src/shared/phone/types'

const here = dirname(fileURLToPath(import.meta.url))
const out = join(here, '..', 'src', 'phone', 'vectors.json')

/** One case: what to open it as, and what must come out (or that nothing may). */
interface Vector {
  name: string
  key: string
  channel: PhoneChannel
  seq: number
  frame: { n: string; d: string }
  /** the payload, JSON-encoded, when the case must OPEN; absent when it must be refused */
  expect?: string
}

const key = mintPairing().viewKey
const otherKey = mintPairing().viewKey

/** One payload per channel, shaped like the real thing so a decode failure is visible. */
const PAYLOADS: Record<PhoneChannel, unknown> = {
  status: { at: 1_757_000_000_000, name: 'Primitive', classes: ['CLR', 'PAL'], level: 60, zone: 'Befallen', inCombat: true, app: '1.20.1' },
  character: { v: 2, capturedAt: 1_757_000_000_000, name: 'Primitive', classes: ['Cleric'], look: { race: '', sex: 'M' }, cells: [], totals: { ac: 447, stats: [], saves: [], unsummed: [], counted: 3, unknown: 0 } },
  fight: { mob: 'a cracked skeleton', live: true, durationMs: 41_000, total: 12_450, members: [{ name: 'Primitive', damage: 9100, dps: 221.9, share: 0.731, you: true }] },
  run: { active: true, zone: 'Befallen 4 (Refined)', base: 'Befallen', tier: 4, startedAt: 1_757_000_000_000, elapsedMs: 1_320_000, kills: 214, groupKills: 0, killsPerMin: 9.7, named: [], keys: [], chest: { items: 0, kept: 0, sold: 0, merged: 0 }, doors: 3, deaths: 1 },
  respawns: [{ id: 'r1', mob: 'Fright', zone: 'Befallen', baseTs: 1_757_000_000_000, dueAt: 1_757_000_600_000, source: 'wiki', open: false }],
  buffs: [{ id: 'b1', name: 'Symbol of Transal', kind: 'buff', startedTs: 1_757_000_000_000, mode: 'countdown', endsAt: 1_757_003_600_000 }],
  events: [{ id: 'e1', kind: 'bossKill', title: 'Boss kill', subtitle: 'Lord Nagafen', at: 1_757_000_000_000 }]
}

const vectors: Vector[] = []

/** The happy path, once per channel: what the desk seals, this app opens — to the same object. */
for (const [index, channel] of PHONE_CHANNELS.entries()) {
  const seq = index + 1
  const payload = PAYLOADS[channel]
  vectors.push({
    name: `round trip: ${channel}`,
    key,
    channel,
    seq,
    frame: encryptFrame(key, channel, seq, payload),
    expect: JSON.stringify(payload)
  })
}

// A `null` payload — "no fight yet" — is a VALUE, not an absence. It must open, to null.
vectors.push({
  name: 'a null payload opens as null, not as a refusal',
  key,
  channel: 'fight',
  seq: 8,
  frame: encryptFrame(key, 'fight', 8, null),
  expect: 'null'
})

// The wrong key: a viewer holding the room id and not the fragment sees noise.
vectors.push({
  name: 'the wrong key sees noise',
  key: otherKey,
  channel: 'status',
  seq: 1,
  frame: encryptFrame(key, 'status', 1, PAYLOADS.status)
})

// The AAD: the channel, then the sequence. Three channels and two neighbours, one case each.
const bound = encryptFrame(key, 'fight', 12, PAYLOADS.fight)
for (const channel of ['status', 'run', 'character'] as PhoneChannel[]) {
  vectors.push({ name: `the AAD binds the channel (read as ${channel})`, key, channel, seq: 12, frame: bound })
}
for (const seq of [11, 13]) {
  vectors.push({ name: `the AAD binds the sequence (read as ${seq})`, key, channel: 'fight', seq, frame: bound })
}

/** One byte flipped inside a base64url field. The tamper cases, exactly as the desktop suite does. */
function flip(text: string, at: number): string {
  const bytes = Buffer.from(text, 'base64url')
  bytes[at] ^= 0x01
  return bytes.toString('base64url')
}

const run = encryptFrame(key, 'run', 3, PAYLOADS.run)
vectors.push({ name: 'a flipped nonce byte is a refusal', key, channel: 'run', seq: 3, frame: { ...run, n: flip(run.n, 0) } })
vectors.push({ name: 'a flipped tag byte is a refusal', key, channel: 'run', seq: 3, frame: { ...run, d: flip(run.d, 0) } })
vectors.push({ name: 'a flipped ciphertext byte is a refusal', key, channel: 'run', seq: 3, frame: { ...run, d: flip(run.d, 20) } })

const buffs = encryptFrame(key, 'buffs', 2, PAYLOADS.buffs)
const short = Buffer.from(buffs.d, 'base64url').subarray(0, 8).toString('base64url')
vectors.push({ name: 'a truncated blob fails a length check', key, channel: 'buffs', seq: 2, frame: { ...buffs, d: short } })
vectors.push({ name: 'a truncated nonce fails a length check', key, channel: 'buffs', seq: 2, frame: { ...buffs, n: buffs.n.slice(0, 8) } })
vectors.push({ name: 'an empty frame is a refusal', key, channel: 'buffs', seq: 2, frame: { n: '', d: '' } })

// A large draw of nonces, so the phone suite can assert what the desktop suite asserts about GCM's
// one unforgivable failure — a repeated nonce under one key — over the DESK's own generator.
const nonces: string[] = []
for (let i = 0; i < 4000; i++) nonces.push(encryptFrame(key, 'status', i, PAYLOADS.status).n)

writeFileSync(
  out,
  `${JSON.stringify({ note: 'GENERATED by mobile/scripts/gen-vectors.mts from src/main/phone/crypto.ts. Do not edit.', vectors, nonces }, null, 2)}\n`
)
process.stdout.write(`gen-vectors: wrote ${String(vectors.length)} vectors and ${String(nonces.length)} nonces\n`)
