{
  "expo": {
    "name": "EQ Zera",
    "slug": "eq-zera",
    "scheme": "eqzera",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0a1f",
    "primaryColor": "#5ee6ff",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.eqzera.app",
      "supportsTablet": true,
      "requireFullScreen": false,
      "associatedDomains": ["applinks:share.eqzera.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "EQ Zera uses the camera once, to scan the pairing QR code shown by the desktop app. Nothing is recorded, stored or sent."
      }
    },
    "android": {
      "package": "com.eqzera.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0a1f"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "share.eqzera.com", "pathPrefix": "/phone" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0a1f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EQ Zera uses the camera once, to scan the pairing QR code shown by the desktop app. Nothing is recorded, stored or sent.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0c0a1f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
