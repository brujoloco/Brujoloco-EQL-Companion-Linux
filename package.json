{
  "name": "eql-companion-brujoloco",
  "version": "0.2.37",
  "license": "FSL-1.1-MIT",
  "description": "Brujoloco EQL Companion — the EverQuest Legends desktop companion (Linux Edition). Live log parsing, overlays, quests, gear and crafting.",
  "main": "./out/main/index.js",
  "author": "Brujoloco",
  "private": true,
  "scripts": {
    "deps:electron": "node node_modules/electron/install.js",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "scrape:posky": "tsx scripts/scrape-posky.ts",
    "scrape:bosses": "node --use-system-ca --import tsx scripts/scrape-bosses.ts",
    "scrape:classes": "tsx scripts/scrape-classes.ts",
    "scrape:mobs": "tsx scripts/scrape-mobs.ts",
    "scrape:quests": "tsx scripts/scrape-quests.ts",
    "scrape:respawns": "tsx scripts/scrape-respawns.ts",
    "scrape:spells": "tsx scripts/scrape-spells.ts",
    "scrape:items": "tsx scripts/scrape-items.ts",
    "scrape:page-era": "tsx scripts/scrape-page-era.ts",
    "refresh:data": "tsx scripts/refresh-data.mts",
    "fetch:images": "node --use-system-ca --import tsx scripts/fetch-wiki-images.mts",
    "fetch:item-models": "tsx scripts/fetch-item-models.mts",
    "engine:baseline": "tsx scripts/engine-baseline.mts",
    "gen:icon": "tsx scripts/gen-icon.mts",
    "gen:sounds": "tsx scripts/gen-sounds.mts",
    "gen:spell-lines": "tsx scripts/gen-spell-lines.ts",
    "gen:data-weight": "node --expose-gc --import tsx scripts/gen-data-weight.mts",
    "gen:protocol": "tsx scripts/gen-protocol.mts",
    "fixtures:e2e": "node --import tsx tests/extract-e2e-fixtures.mjs",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "test": "node --import tsx scripts/testGate.mts unit -- node --import tsx --test --test-concurrency=auto tests/*.test.mts",
    "test:e2e": "node --import tsx scripts/testGate.mts e2e -- node --import tsx tests/e2e/run-all.mts",
    "oracle:rust-parser": "node --import tsx tests/bench/rustParity.mts",
    "oracle:rust-fold": "node --import tsx tests/bench/rustParity.mts --snapshots",
    "check:rust-factoring": "tsx scripts/checkRustFactoring.mts",
    "budget:ci": "cargo test --release --manifest-path engine/Cargo.toml -p zengine --test budget the_synthetic -- --nocapture",
    "gen:engine-spell-overlay": "tsx scripts/gen-engine-spell-overlay.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:engine": "tsx scripts/build-engine.mts",
    "dist": "npm run build && npm run build:engine && electron-builder --linux AppImage",
    "dist:dir": "npm run build && npm run build:engine && electron-builder --linux AppImage --dir"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "chokidar": "^4.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "koffi": "2.16.3",
    "onnxruntime-node": "1.20.1",
    "phonemizer": "1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "json-schema-to-typescript": "^15.0.4",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "builder-util-runtime": "^9.7.0",
    "tar": "^7.5.22",
    "vite": {
      "esbuild": "$esbuild"
    },
    "electron-vite": {
      "esbuild": "$esbuild"
    }
  }
}
